# Optional: USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup).
# Without it, food search uses Open Food Facts (no key needed) plus the offline space pantry.
VITE_USDA_API_KEY=
# Public Worker URL used by the browser. Keep all Worker credentials server-side.
VITE_API_URL=https://api.evade.health
