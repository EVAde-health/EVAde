{
  "$schema": "node_modules/wrangler/config-schema.json",
  // EVAde voice agent on Cloudflare Workers (TypeScript port of api/voice*.py).
  "name": "evade",
  "account_id": "2e5df567f3580c5af313ebb51e1920fa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],

  // Serve everything on evade.health (Cloudflare creates the DNS record + cert on deploy).
  "workers_dev": false,
  "routes": [{ "pattern": "evade.health", "custom_domain": true }],

  // No static assets: the old /voice/ browser page was removed (the web app's Journal tab
  // is the browser client now). On evade.health, deploy/wrangler.jsonc adds the web app
  // build as assets; here every path hits the Worker and unknown paths are 404.

  // One Durable Object per live call / browser session holds the WebSocket bridge to xAI.
  "durable_objects": {
    "bindings": [{ "name": "VOICE_SESSION", "class_name": "VoiceSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceSession"] }],

  // Check-ins, downlink queue and one-time stream tokens (replaces data/evade.db).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evade",
      "database_id": "85855cd2-6a51-48b7-8142-6351ccede1d1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "PUBLIC_BASE_URL": "https://evade.health",
    "TWILIO_ACCOUNT_SID": "ACaf8ad78c4d47f613d6fb9c618743dbf8",
    "TWILIO_PHONE_NUMBER": "+19086631285",
    "XAI_MODEL": "grok-voice-latest",
    "XAI_VOICE": "atlas",
    "EVADE_COMMS_MODE": "online",
    "TWILIO_VALIDATE_SIGNATURE": "true",
    // Comma-separated list of origins allowed by CORS, or "*". Auth is a bearer header
    // (no cookies), so "*" is safe for the React Native app and web clients.
    "CORS_ALLOW_ORIGINS": "*",
    // Hackathon demo: when "true", the web/app voice page and read APIs are open
    // (no access key). Outbound alerts stay token-protected. Set to "false" and
    // redeploy to require EVADE_BROWSER_TOKEN again. Spending guards below still apply.
    "DEMO_OPEN": "true",
    // Max length of a browser/app voice session, in seconds (phone calls use 600).
    "MAX_SESSION_SECONDS": "300",
    // Max concurrent browser/app voice sessions (phone calls are not counted).
    "MAX_CONCURRENT_SESSIONS": "5"
  },

  // Set with `npx wrangler secret put <NAME>`; never commit values.
  "secrets": {
    "required": ["XAI_API_KEY", "TWILIO_AUTH_TOKEN", "EVADE_BROWSER_TOKEN", "EVADE_ALERT_TOKEN"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
