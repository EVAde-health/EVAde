{
  "expo": {
    "name": "EVAde",
    "slug": "evade",
    "version": "1.0.0",
    "scheme": "evade",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F1A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.evade.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EVAde uses the camera for selfie check-ins in your private journal.",
        "NSMicrophoneUsageDescription": "EVAde uses the microphone for voice journal check-ins.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "health.evade.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F1A"
        }
      ]
    ]
  }
}
