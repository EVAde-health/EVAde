{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evade-api",
  "main": "src/index.ts",
  "services": [{ "binding": "MODELS", "service": "evade-gateway" }],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true },
  // Public API address on Daniel's domain (evade.health must be a zone in the EVAde Cloudflare account)
  "routes": [{ "pattern": "api.evade.health", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evade-db",
      "database_id": "7f59200b-d17f-44d8-af6d-a8e51e137d2c",
      "migrations_dir": "migrations"
    }
  ],
  // Private uploads, accessed through the authenticated media endpoints.
  // MODEL_ARTIFACTS: Michael's model bucket. This Worker only reads models/<task>/manifest.json from it, so the
  // Models page can show the weight SHA-256 that evade-gateway verifies when it loads each model.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "evade-media" },
    { "binding": "MODEL_ARTIFACTS", "bucket_name": "evade-models" }
  ],
  // Selfie assessment. The image stays on Workers AI; USDA_API_KEY stays a secret (see below).
  "ai": { "binding": "AI" },
  // Live crew feed over WebSockets
  "durable_objects": { "bindings": [
    { "name": "LIVE", "class_name": "CrewFeed" },
    { "name": "ABUSE_BUDGET", "class_name": "AbuseBudget" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrewFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["AbuseBudget"] }
  ],
  // Sessions + OAuth state (Workers KV)
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "784305dfc43442a78ccc2aac162e5811" }],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "11340105", "simple": { "limit": 20, "period": 60 } },
    { "name": "SIGN_IN_IP_LIMITER", "namespace_id": "11340106", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEMO_WRITE_IP_LIMITER", "namespace_id": "11340107", "simple": { "limit": 15, "period": 60 } },
    { "name": "DEMO_RESET_IP_LIMITER", "namespace_id": "11340108", "simple": { "limit": 3, "period": 60 } }
  ],
  // Pull NOAA space weather every 15 minutes into the space_weather table
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // Exact HTTPS origins allowed to use the browser session. Override locally for local development.
    "ALLOWED_ORIGINS": "https://evade.health,https://www.evade.health",
    // Michael's model API sits behind the "evade-gateway" Worker (Cloudflare Container). Preferred: the "MODELS"
    // service binding below (no public URL). Fallback only: set MODEL_API_URL to the gateway's HTTPS URL.
    // Until either is set, /predict/* and /models return 503.
    "MODEL_API_URL": "",
    // "true" enables GET /auth/demo: a 2-hour shared session as Demo Astronaut, or (?as=surgeon) Demo Flight Surgeon.
    // It reads and writes only the demo crew; POST /demo/reset restores the unchecked two-user seed. Never a real user.
    "DEMO_LOGIN": "true",
    "TURNSTILE_SITE_KEY": "",
    "NEW_ACCOUNT_IP_HOURLY": "3",
    "AI_DAILY_CALL_BUDGET": "3000",
    "AI_PER_USER_DAILY": "120",
    "AI_STAFF_DAILY_CALL_BUDGET": "6000",
    "AI_STAFF_PER_USER_DAILY": "600",
    "VOICE_DAILY_SECONDS_BUDGET": "18000",
    "MODEL_PER_USER_DAILY": "100",
    // Where users land after signing in if no redirect was requested.
    "FRONTEND_URL": "https://evade.health",
    // Comma-separated emails promoted to flight_surgeon when they sign in with a verified email (Cloudflare Access,
    // Google, GitHub). Promotion only; it never demotes. Otherwise the users.role column in D1 decides.
    "FLIGHT_SURGEON_EMAILS": "ryana.bergmanamazon@gmail.com",
    // Everyone (astronauts and flight surgeons) signs in through this one Access application.
    "ACCESS_TEAM_DOMAIN": "evade-health.cloudflareaccess.com",
    "ACCESS_AUD": "ecbeabe1fc1a7bca3ebee00b3aef522ecd96ac431b0f9dd9b0d8ae3d06dc093b",
    // "true" shows a no-OAuth test login. Keep "false" in production.
    "DEV_LOGIN": "false",
    // Who decides "days until return" in GET /users/:id/prediction. "ai" (default): trend math in this Worker, with
    // Grok ranking the most concerning metric and explaining it. "model-api": the custom model's POST /v1/predict/risk
    // via evade-gateway (falls back to "ai" if the gateway is not connected or fails).
    "PREDICTION_PROVIDER": "ai",
    // Lead time in days to arrange a return; the model service withholds days-to-return without it.
    "LOGISTICS_FLOOR_DAYS": "3",
    // xAI Grok models (journal analysis, journal companion, staff summaries, daily briefing, speech-to-text).
    // The key is the XAI_API_KEY secret below. "" for the fallback disables it. Model list: https://docs.x.ai/developers/models
    "XAI_TEXT_MODEL": "grok-4.20-0309-non-reasoning",
    "XAI_FALLBACK_TEXT_MODEL": "grok-4.3",
    "XAI_STT_MODEL": "grok-voice-transcribe-2.0"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   EVADE_API_KEY  server-side service key for the X-EVAde-Key header
  //   XAI_API_KEY    xAI API key (console.x.ai) for every AI feature. Without it entries still save, but there is no
  //                  analysis, companion question choice (rule-based reply), staff summary (rule-based bullets),
  //                  briefing (rules) or speech-to-text (503)
  //   MODEL_GATEWAY_KEY  sent as X-Gateway-Key to evade-gateway (same value as the gateway's GATEWAY_CALLER_KEY)
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   Google OAuth client
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   GitHub OAuth app
  //   TURNSTILE_SECRET      Existing OAuth Turnstile secret, if enabling optional OAuth providers
  //   USDA_API_KEY   FoodData Central key for GET /foods/search on this Worker (evade-api).
  //                  Never put it in the browser. If it is unset, search falls back to the pantry and Open Food Facts.
}
