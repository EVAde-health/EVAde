# Copy to .env and fill in. Never commit .env.

# xAI (console.x.ai -> API keys)
XAI_API_KEY=
# Optional: voice for the agent (default eve; e.g. ara, rex, sal, leo)
XAI_VOICE=eve
# Optional: pin a model (default grok-voice-latest)
# XAI_MODEL=grok-voice-latest

# Twilio: phone mode only (console.twilio.com -> Account info). Browser mode needs only XAI_API_KEY.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +15551234567
TWILIO_PHONE_NUMBER=

# Phone mode only. Public HTTPS URL that reaches this server (ngrok / cloudflared), no trailing slash
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Optional
# TWILIO_VALIDATE_SIGNATURE=true      # set false only for local testing without Twilio
# EVADE_COMMS_MODE=online             # online (ISS) | mars (20-min delay) | blackout
# EVADE_BROWSER_TOKEN=                # lets another machine use /voice/browser?token=... (browser mode is localhost-only otherwise)
# EVADE_ALERT_TOKEN=                  # required header X-EVADE-Token for POST /voice/alert from other machines
# EVADE_DB_PATH=data/evade.db
